# Copy to .env (repository root) and adjust. The backend reads it automatically on startup.
# Every value has a sensible default for local development except JWT_SECRET in production.

# MongoDB connection string (local install, Docker, or MongoDB Atlas "mongodb+srv://...")
MONGODB_URI=mongodb://localhost:27017/splitmate

# Secret used to sign login tokens (HS256). At least 32 bytes.
# Required with the prod profile. In dev/demo a random one is generated if empty
# (which logs everyone out on every restart).
# Generate one with:  openssl rand -base64 48
JWT_SECRET=

# Public URL of the frontend, used to build invite links (/join/{code}).
# Dev (Vite):        http://localhost:5173
# Single jar (prod): the same address as the backend, e.g. http://localhost:8090
APP_BASE_URL=http://localhost:5173

# Mark the auth cookie as Secure (HTTPS only). Defaults to true in the prod profile.
COOKIE_SECURE=false

# Extra origins allowed to call the API with credentials (comma separated). Not needed when
# the Vite dev proxy or the single jar is used, because then everything is same-origin.
CORS_ALLOWED_ORIGINS=http://localhost:5173

# HTTP port of the backend (8090 because port 8080 is often taken, e.g. by Jenkins)
PORT=8090

# Frontend dev only: where the Vite dev server proxies /api to. Keep it in sync with PORT
# (default http://localhost:8090).
BACKEND_URL=http://localhost:8090
